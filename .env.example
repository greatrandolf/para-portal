# Copy to .env.local (git-ignored) and adjust. See para-backend/docs/deployment.md.
#
# Leave EXPO_PUBLIC_FIREBASE_API_KEY unset to use the local Firebase emulators
# (Auth :9099, Functions :5001): cd ../para-backend/functions && npm run emulators
#
# Deployed project (staging example):
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=para-staging.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=para-staging
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FUNCTIONS_URL=https://asia-southeast1-para-staging.cloudfunctions.net
#
# Road routing (development uses the public OSRM demo server):
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org

# With a real web config above, set this to sign in against the local Auth emulator
# (needed locally for team invites, because accepting an invite creates the account where the functions run).
# EXPO_PUBLIC_USE_AUTH_EMULATOR=1
